# Docling Serve (конвертация docx, pptx, html, xlsx, csv, md, xml, json и PDF с текстом)
DOC_URL=http://localhost:9001
# vLLM с PaddleOCR-VL (OCR изображений)
VLLM_URL=http://localhost:8400
VLLM_API_KEY=
MODEL_NAME=PaddlePaddle/PaddleOCR-VL
# PaddleOCR-VL_pdf_ocr_server (OCR PDF-сканов)
OCR_URL=http://localhost:9000

# Максимальное время ожидания обработки файла в Docling, секунды
DOCLING_TIMEOUT=3600
# Интервал опроса статуса задачи в Docling, секунды
DOCLING_POLL_INTERVAL=10
# Таймаут запроса к vLLM, секунды
VLLM_REQUEST_TIMEOUT=300
# Таймаут запроса к OCR-серверу PDF, секунды (PDF обрабатывается постранично, поэтому долго)
OCR_REQUEST_TIMEOUT=3600
# Минимум символов текстового слоя, при котором PDF не считается сканом
PDF_MIN_TEXT_LENGTH=100

HOST=0.0.0.0
PORT=8999
LOG_LEVEL=INFO
